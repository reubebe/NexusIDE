{
  "name": "nexuside",
  "version": "0.2.0",
  "private": true,
  "description": "One runtime. Any agent. Any model.",
  "type": "module",
  "bin": {
    "nexus": "./src/cli.js"
  },
  "files": [
    "src/",
    "ui/",
    "scripts/setup-pty.js",
    "scripts/verify-local-model.js",
    "scripts/verify-development.js",
    "scripts/verify-sandbox.js",
    "scripts/verify-vscode.js",
    "scripts/verify-semantic-memory.js",
    "scripts/verify-codegraph.js",
    "scripts/verify-responsive.js",
    "README.md",
    "SECURITY.md",
    "docs/",
    "integrations/",
    "examples/",
    "extensions/vscode/",
    "scripts/build-desktop.js",
    "scripts/package-desktop.js",
    "scripts/desktop-package-utils.js",
    "scripts/verify-bundled-desktop.js",
    "desktop/",
    "scripts/verify-desktop.js",
    "scripts/verify-research-evidence.js",
    "scripts/verify-storage-scale.js",
    "scripts/macos-signing.js",
    "scripts/release-preflight.js",
    "scripts/notarize-desktop.js",
    "scripts/verify-release.js",
    "scripts/verify-pilot.js"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test",
    "postinstall": "node scripts/setup-pty.js",
    "desktop:build": "node scripts/build-desktop.js",
    "desktop": "node src/cli.js desktop",
    "desktop:package": "node scripts/package-desktop.js",
    "desktop:verify-bundle": "node scripts/verify-bundled-desktop.js",
    "release:preflight": "node scripts/release-preflight.js",
    "release:notarize": "node scripts/notarize-desktop.js",
    "verify:release": "node scripts/verify-release.js",
    "verify:pilot": "node scripts/verify-pilot.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "node-pty": "1.1.0",
    "yaml": "2.9.1"
  }
}
